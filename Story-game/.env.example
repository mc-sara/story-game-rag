# Story-game local environment template
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or real API keys.
#
# LLM 调用已由 server.js 的服务端代理处理（POST /api/chat-completions），
# Key 只从环境变量读取，不再暴露给浏览器。

# DeepSeek API key（服务端代理使用）。
API_KEY=your_api_key_here

# DeepSeek chat completions base URL（服务端代理使用）。
BASE_URL=https://api.deepseek.com

# Chat model name（DeepSeek 官方模型：deepseek-v4-flash / deepseek-v4-pro）。
MODEL=deepseek-v4-flash

# Generation defaults.
MAX_TOKENS=2048
TEMPERATURE=0.8

# Story-game server port.
PORT=3002

# Internal RAG Agent service URL used by Story-game proxy routes.
RAG_AGENT_URL=http://localhost:3000
