# RAG Agent 环境变量配置
# 复制此文件为 .env 并填入实际值

# oops.asia API 配置
API_KEY=your_api_key_here
BASE_URL=https://api.hushijunshitiancai666.store/v1

# 模型配置
MODEL=gpt-5.5
MAX_TOKENS=2048
TEMPERATURE=0.7

# RAG 配置
TOP_K_CHUNKS=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 服务配置
PORT=3000
TIMEOUT=60000
INDEX_FILE=./index.json
