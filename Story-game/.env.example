# Story-game local environment template
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or real API keys.
#
# Current Story-game frontend still reads `config.js` in the browser.
# If you use direct browser LLM calls for local testing, keep only test keys
# there. For production, route LLM calls through the server.

# LLM API key used for local testing.
API_KEY=your_api_key_here

# OpenAI-compatible chat completions base URL.
# Example: https://api.example.com/v1
BASE_URL=https://api.example.com/v1

# Chat model name.
MODEL=your_model_name_here

# Generation defaults.
MAX_TOKENS=2048
TEMPERATURE=0.8

# Story-game server port.
PORT=3002

# Internal RAG Agent service URL used by Story-game proxy routes.
RAG_AGENT_URL=http://localhost:3000
